{
  "name": "@vibe-monitor/setup",
  "version": "1.0.0",
  "private": false,
  "description": "Vibe Monitor open-source architecture intelligence client",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tubban1/vibe-monitor.git"
  },
  "bin": {
    "vibe-monitor": "dist/vibe-monitor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "esbuild src/cli.js --bundle --packages=external --platform=node --format=esm --target=node20 --minify --legal-comments=none --outfile=dist/vibe-monitor.mjs && esbuild src/scan-worker.js --bundle --packages=external --platform=node --format=esm --target=node20 --minify --legal-comments=none --outfile=dist/vibe-monitor-scan-worker.mjs",
    "test": "node --test test/oss-community-public-contract.test.js test/oss-community-public-smoke.test.js test/oss-source-history-audit.test.js test/oss-agent-ownership.test.js test/cloud-owned-rulepack.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "json5": "^2.2.3",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
